<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Untuk Kamu ❤️</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#080609;color:#fff;font-family:Georgia,serif;overflow:hidden}
#intro{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:28px;background:radial-gradient(ellipse at center,#321b2a 0,#100b12 58%,#030304 100%)}
#letter{max-width:520px;line-height:1.8;font-size:clamp(20px,5vw,28px);text-shadow:0 2px 12px #000}
#start{margin-top:28px;padding:14px 25px;border:1px solid #e8b9cb;border-radius:30px;background:#8e345b;color:white;font-size:16px}
#scare{display:none;position:fixed;inset:0;background:#000;align-items:center;justify-content:center}
#scare img{width:100%;height:100%;object-fit:cover;animation:shake .09s infinite}
#flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none}
#end{display:none;position:fixed;inset:0;background:#080609;align-items:center;justify-content:center;text-align:center;padding:25px;font:20px Arial}
@keyframes shake{0%{transform:translate(0,0) scale(1.03)}25%{transform:translate(5px,-3px) scale(1.07)}50%{transform:translate(-4px,4px) scale(1.04)}75%{transform:translate(3px,3px) scale(1.08)}100%{transform:translate(-3px,-4px) scale(1.03)}}
</style>
</head>
<body>
<div id="intro">
  <div id="letter">
    <div id="line">Aku sebenarnya mau bilang sesuatu...</div>
    <button id="start">Buka pesan ❤️</button>
  </div>
</div>
<div id="scare"><img src="hantu.jpg" alt="Wajah menyeramkan"></div>
<div id="flash"></div>
<div id="end">WKWKWK 😂<br><br>Kamu kena prank!<br><small style="color:#aaa">Tenang, ini cuma prank.</small></div>
<audio id="scream" src="screamer.m4a" preload="auto"></audio>
<script>
const start=document.getElementById('start'), line=document.getElementById('line');
const audio=document.getElementById('scream');
const messages=[
"Aku sebenarnya mau bilang sesuatu...",
"Sejak kenal kamu, ada hal yang selalu ingin aku sampaikan.",
"Jangan kaget ya, baca sampai selesai...",
"Aku harap kamu nggak takut setelah ini ❤️"
];
start.addEventListener('click',()=>{
  start.disabled=true; start.style.display='none';
  // Prime audio playback from the user's tap for mobile browser permission.
  audio.volume=1;
  const priming=audio.play();
  if(priming){priming.then(()=>{audio.pause();audio.currentTime=0;}).catch(()=>{});}
  let i=0;
  const timer=setInterval(()=>{
    i++;
    if(i<messages.length){line.textContent=messages[i];}
    else{
      clearInterval(timer);
      document.getElementById('intro').style.display='none';
      const scare=document.getElementById('scare');
      scare.style.display='flex';
      audio.currentTime=0;
      audio.play().catch(()=>{});
      const flash=document.getElementById('flash');
      let n=0;const blink=setInterval(()=>{flash.style.opacity=flash.style.opacity==='0.9'?'0':'0.9';if(++n>12){clearInterval(blink);flash.style.opacity=0}},100);
      if(navigator.vibrate)navigator.vibrate([250,100,250,100,500]);
      setTimeout(()=>{scare.style.display='none';document.getElementById('end').style.display='flex';},4800);
    }
  },2200);
});
</script>
</body>
</html>
